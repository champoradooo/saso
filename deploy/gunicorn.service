[Unit]
Description=SASO App - Gunicorn WSGI Server
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/saso-app
EnvironmentFile=/home/ubuntu/saso-app/.env
ExecStart=/home/ubuntu/saso-app/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --access-logfile /home/ubuntu/saso-app/logs/gunicorn-access.log \
    --error-logfile /home/ubuntu/saso-app/logs/gunicorn-error.log \
    backend.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
